#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "keymap_italian.h"

// Layer definitions

#define BASE 0
#define SYM 1
#define EXT 2
#define FNC 3
#define SYM2 4
#define ACCENT 5
#define SETTINGS 6

// -----------------

&sk {
    // don't release mods on other mods presses

    ignore-modifiers;
};

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
    flavor = "balanced";
};

/ {
    behaviors {
        // Enables holding the first mod-tap key
        // by performing a tap-release-hold sequence.
        // To use it: "&qt KEYCODE1 KEYCODE2"

        hr: homerow {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <130>;
            require-prior-idle-ms = <0>;
            flavor = "tap-preferred";
        };

        ht: holdtap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <130>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <0>;
            flavor = "balanced";
        };

        td2: tapdance2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAPDANCE2";
            #binding-cells = <0>;
            bindings = <&Domain>;
            tapping-term-ms = <300>;
        };

        td1: tapdance1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAPDANCE1";
            #binding-cells = <0>;
            bindings = <&PW1>, <&PW2>, <&PW3>;

            tapping-term-ms = <300>;
        };
    };

    macros {
        // sometimes my device thinks a modifier is being held down
        // pressing all modifiers fixes it.

        PW1: PW1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N2 &kp N0 &kp N2 &kp N2 &kp N0 &kp N9 &kp N0 &kp N1 &kp Q &kp EXCL &kp AT &kp POUND>;
            label = "PW1";
        };

        PW2: PW2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp T &kp N0 &kp L &kp E &kp R &kp AT &kp N &kp C &kp E>;
            label = "PW2";
        };

        PW3: PW3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp AT &kp E &kp L &kp V &kp H &kp X &kp K &kp D &kp L &kp A>;
            label = "PW3";
        };

        Domain: Domain {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp O &kp F &kp F &kp I &kp C &kp E &kp D &kp E &kp P &kp O &kp T &kp DOT &kp C &kp O &kp DOT &kp K &kp R>;
            label = "DOMAIN";
        };
    };

    combos {
        compatible = "zmk,combos";

        // both right thumb keys
        // internal-left & external-right thumb keys
        // both left thumb keys
        // left index & middle fingers (home-row)
        // hold control & space for Adobe workflow

        LANGchange_combo {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <17 18>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
            slow-release;
            layers = <0>;
        };

        ESC_combo {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
            slow-release;
        };

        TAB_combo {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
        };

        ENTER_combo {
            bindings = <&kp ENTER>;
            key-positions = <16 17>;
            timeout-ms = <50>;
            require-prior-idle-ms = <50>;
            slow-release;
        };

        COPY_combo {
            bindings = <&kp LC(C)>;
            key-positions = <12 13>;
            timeout-ms = <50>;
            require-prior-idle-ms = <120>;
            slow-release;
        };

        PASTE_combo {
            bindings = <&kp LC(V)>;
            key-positions = <12 23>;
            timeout-ms = <50>;
            require-prior-idle-ms = <120>;
            slow-release;
        };

        momentary_layer_bluetooth {
            bindings = <&mo 3>;
            key-positions = <20 21 22 23>;
            layers = <0>;
        };

        Capture_combo {
            bindings = <&kp LS(LG(S))>;
            key-positions = <1 2 3>;
            timeout-ms = <50>;
            require-prior-idle-ms = <120>;
            slow-release;
        };

        DEL_combo {
            bindings = <&kp DELETE>;
            key-positions = <5 6>;
        };

        F2_Combo {
            bindings = <&kp F2>;
            key-positions = <3 4>;
            timeout-ms = <50>;
            require-prior-idle-ms = <120>;
            slow-release;
            layers = <0>;
        };

        Bootloder_combo {
            bindings = <&bootloader>;
            key-positions = <31 32>;
            layers = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Base alpha layer

        Base {
            label = "Base";
            bindings = <
&kp Q           &kp W  &kp E               &kp R             &kp T      &kp Y          &kp U              &kp I      &kp O    &kp P
&hr LEFT_ALT A  &kp S  &hr LEFT_CONTROL D  &hr LEFT_SHIFT F  &kp G      &kp H          &hr RIGHT_SHIFT J  &kp K      &kp L    &hr RIGHT_GUI SEMICOLON
&kp Z           &kp X  &kp C               &kp V             &kp B      &kp N          &kp M              &kp COMMA  &kp DOT  &kp SLASH
                                           &mo 2             &kp SPACE  &kp BACKSPACE  &mo 1
            >;
        };

        // Numbers and high frequency symbols
        // Main modifiers and arrow keys
        // Function keys with modifiers
        // Low frequency symbols.
        // Used to type regional accents.

        Funtion {
            label = "Funtion";
            bindings = <
&none  &none  &none  &none  &none  &kp F12  &kp F7  &kp F8  &kp F9  &none
&none  &none  &none  &none  &none  &kp F11  &kp F4  &kp F5  &kp F6  &none
&none  &none  &none  &none  &none  &kp F10  &kp F1  &kp F2  &kp F3  &none
                     &none  &none  &none    &none
            >;
        };

        // Used to change the keyboard's settings.

        Num {
            label = "Num";
            bindings = <
&kp TILDE  &none      &kp UP        &none      &none      &kp MINUS  &kp N7  &kp N8  &kp N9  &kp SQT
&kp LSHFT  &kp LEFT   &kp DOWN      &kp RIGHT  &none      &kp EQUAL  &kp N4  &kp N5  &kp N6  &kp LBKT
&kp PLUS   &kp MINUS  &kp ASTERISK  &kp SLASH  &kp DOT    &kp BSLH   &kp N1  &kp N2  &kp N3  &kp RBKT
                                    &none      &kp SPACE  &kp DEL    &kp N0
            >;
        };

        Bluetooth {
            label = "Bluetooth";
            bindings = <
&none  &none  &none  &none  &bt BT_CLR_ALL  &bt BT_CLR  &none         &none         &none         &none
&none  &none  &none  &none  &none           &none       &bt BT_SEL 3  &bt BT_SEL 4  &none         &none
&none  &none  &none  &none  &none           &none       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none
                     &none  &none           &none       &none
            >;
        };

        Empty {
            label = "Empty";
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none
                     &none  &none  &none  &none
            >;
        };
    };
};
